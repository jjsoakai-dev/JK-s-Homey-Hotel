package ui;

import Hotel.Customer;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.layout.VBox;
import javafx.stage.Stage;

public class CustomerDashboard {

    private Customer user;

    public CustomerDashboard(Customer user) {
        this.user = user;
    }

    public void start(Stage stage) {

        Button bookRoom = new Button("Book Room");
        Button viewBookings = new Button("My Bookings");

        VBox layout = new VBox(10, bookRoom, viewBookings);

        stage.setScene(new Scene(layout, 400, 300));
        stage.setTitle("Customer Dashboard - " + user.getName());
        stage.show();
    }
}
