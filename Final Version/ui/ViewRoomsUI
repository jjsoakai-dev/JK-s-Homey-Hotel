package ui;

import dao.RoomDAO;
import model.Room;

import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.util.ArrayList;

public class ViewRoomsUI {

    public void show() {

    JFrame frame = new JFrame("View Rooms");
    frame.setSize(500, 300);
    frame.setLayout(null); // important for positioning

    String[] columnNames = {"Room Number", "Type", "Price", "Available"};
    DefaultTableModel model = new DefaultTableModel(columnNames, 0);

    JTable table = new JTable(model);
    JScrollPane scrollPane = new JScrollPane(table);
    scrollPane.setBounds(20, 20, 440, 180); // set table position
    frame.add(scrollPane);

    // Load data from database
    RoomDAO dao = new RoomDAO();
    ArrayList<Room> rooms = dao.getAllRooms();

    for (Room r : rooms) {
        Object[] row = {
            r.getRoomNumber(),
            r.getRoomType(),
            r.getPrice(),
            r.isAvailable() ? "Yes" : "No"
        };
        model.addRow(row);
    }

    // ADD BACK BUTTON
    JButton backButton = new JButton("Back");
    backButton.setBounds(200, 220, 100, 30);
    frame.add(backButton);

    // Back button action
    backButton.addActionListener(e -> {
        frame.dispose(); // closes the rooms window
    });

    frame.setVisible(true);
}
    
}


